<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>REJA</title>

    <link rel="stylesheet" href="/author/main.css" />

    <link
      rel="stylesheet"
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.2.1/css/bootstrap.min.css"
    />
  </head>

  <body class="reja-page">
    <div class="reja-overlay"></div>

    <main class="reja-container">

      <!-- Header -->
      <header class="reja-header">
        <div class="header-badge">PERSONAL PLANNER</div>

        <h1>REJA <span>VA MAQSADLAR</span></h1>

        <p>
          Bugungi rejalaringizni yozing, maqsadlaringiz sari harakat qiling.
        </p>
      </header>


      <!-- Create Plan -->
      <section class="create-card">

        <div class="card-title">
          <span class="title-icon">✦</span>
          <div>
            <h2>Yangi reja</h2>
            <p>Bugun nima qilishni rejalashtiryapsiz?</p>
          </div>
        </div>

        <form id="create-form" action="/create-item" method="POST">
          <div class="create-form">

            <input
              id="create-field"
              name="reja"
              autofocus
              autocomplete="off"
              class="create-input"
              type="text"
              placeholder="Masalan: Ingliz tilini 1 soat o'rganish..."
            />

            <button class="create-button">
              <span>+</span>
              Yangi reja
            </button>

          </div>
        </form>

      </section>


      <!-- Plans -->
      <section class="plans-section">

        <div class="section-heading">
          <div>
            <span class="section-label">MY PLANS</span>
            <h2>Bugungi rejalar</h2>
          </div>

          <span class="plan-count">
            <%= items.length %> ta
          </span>
        </div>


        <ul id="item-list" class="plans-list">

          <% items.map(function(item) { %>

            <li class="plan-item">

              <div class="plan-left">

                <div class="plan-number">
                  <%= items.indexOf(item) + 1 %>
                </div>

                <span class="item-text">
                  <%= item.reja %>
                </span>

              </div>


              <div class="plan-actions">

                <button
                  data-id="<%= item._id %>"
                  class="edit-me edit-button"
                >
                  O'zgartirish
                </button>

                <button
                  data-id="<%= item._id %>"
                  class="delete-me delete-button"
                >
                  O'chirish
                </button>

              </div>

            </li>

          <% }) %>

        </ul>

      </section>


      <!-- Delete All -->
      <button id="clean-all" class="delete-all-button">
        <span>×</span>
        Hamma rejalarni o'chirish
      </button>


      <!-- Footer -->
      <footer class="reja-footer">
        <span>FOCUS</span>
        <span class="footer-dot">•</span>
        <span>DISCIPLINE</span>
        <span class="footer-dot">•</span>
        <span>PROGRESS</span>
      </footer>

    </main>
    <script src="https://unpkg.com/axios/dist/axios.min.js"></script>
    <script src="/browser.js"></script>
  </body>
</html>
